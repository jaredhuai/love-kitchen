{
  "name": "love-kitchen",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @love-kitchen/api dev",
    "build": "pnpm -r build",
    "quality:prepare": "pnpm db:generate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @love-kitchen/api test:e2e",
    "test:idor": "pnpm --filter @love-kitchen/api test:idor",
    "test:preferences": "pnpm --filter @love-kitchen/api test:preferences",
    "test:uploads": "pnpm --filter @love-kitchen/api test:uploads",
    "test:outbox": "pnpm --filter @love-kitchen/worker test",
    "test:consumers": "pnpm --filter @love-kitchen/worker test:consumers",
    "test:letters": "pnpm --filter @love-kitchen/api test:letters",
    "test:auth-session": "pnpm --filter @love-kitchen/api test:auth-session",
    "test:account-jobs": "pnpm --filter @love-kitchen/api test:account-jobs",
    "test:security": "pnpm test:idor && pnpm test:preferences && pnpm test:uploads && pnpm test:outbox && pnpm test:letters && pnpm test:auth-session && pnpm test:account-jobs",
    "test:coverage": "pnpm --filter @love-kitchen/api test:coverage",
    "test:migration": "pnpm --filter @love-kitchen/api test:migration",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @love-kitchen/api prisma:generate",
    "db:migrate": "pnpm --filter @love-kitchen/api prisma:migrate",
    "db:seed": "pnpm --filter @love-kitchen/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
