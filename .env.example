NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/love_kitchen
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_LOGIN_TIMEOUT_MS=5000
LOVE_LETTER_ENCRYPTION_KEY=replace_with_64_hex_characters
LOVE_LETTER_KEY_VERSION=1
UPLOAD_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_COS_FALLBACK_LOCAL=true
MAX_UPLOAD_SIZE_MB=10
# COS 私有桶部署时设置 UPLOAD_DRIVER=cos 并通过密钥管理系统注入以下配置
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=
MAX_ACTIVE_KITCHENS_PER_USER=1
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=300000
WORKER_MAX_ATTEMPTS=5
WORKER_BATCH_SIZE=100
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000
OUTBOX_BACKLOG_ALERT_THRESHOLD=1000
OUTBOX_DEAD_ALERT_THRESHOLD=1
OUTBOX_OLDEST_PENDING_ALERT_SECONDS=300
ACCOUNT_DELETION_COOLING_DAYS=7
ACCOUNT_PERMANENT_PURGE_ENABLED=false
REMINDER_TIMEZONE=Australia/Sydney
