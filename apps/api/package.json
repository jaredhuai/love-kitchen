{
  "name": "@love-kitchen/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run",
    "test:e2e": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} prisma migrate deploy && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/http.spec.ts test/postgres.spec.ts test/auth-session.e2e.spec.ts test/account-jobs.e2e.spec.ts test/ai-orchestrator.e2e.spec.ts test/meal-plans.idor.e2e.spec.ts test/preferences-state.e2e.spec.ts test/uploads.security.e2e.spec.ts test/love-letters.security.e2e.spec.ts test/dishes-v2.e2e.spec.ts test/timeline-v2.e2e.spec.ts test/meal-history-v2.e2e.spec.ts test/notifications-v2.e2e.spec.ts test/ai-conversations-v2.e2e.spec.ts",
