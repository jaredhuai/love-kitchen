    "test:postgres": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/postgres.spec.ts",
    "test:idor": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/meal-plans.idor.e2e.spec.ts",
    "test:preferences": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/preferences-state.e2e.spec.ts",
    "test:uploads": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/uploads.security.e2e.spec.ts",
    "test:ai-security": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/ai.spec.ts",
    "test:ai-orchestrator": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/ai.spec.ts test/ai-orchestrator.e2e.spec.ts",
    "test:letters": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/love-letters.security.e2e.spec.ts",
    "test:auth-session": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/auth.spec.ts test/auth-session.e2e.spec.ts",
    "test:account-jobs": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run test/account-jobs.e2e.spec.ts",
    "test:coverage": "prisma generate && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} REDIS_URL=${TEST_REDIS_URL:-redis://localhost:6379/15} vitest run --coverage",
    "test:migration": "prisma generate && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} prisma validate && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} prisma migrate deploy && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/love_kitchen_test} vitest run test/migration.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "backfill:m5-uploads": "tsx prisma/backfills/m5_upload_checksums.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
