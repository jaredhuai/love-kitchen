<view class="page"><view class="title">厨房情书</view><view wx:if="{{loading}}" class="card muted">正在加载…</view><view wx:if="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重试</button></view><view wx:if="{{!loading && !error && !letters.length}}" class="card muted">还没有收到情书。写信功能会在选择厨房成员后开放。</view><view wx:for="{{letters}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text>{{item.title}}</text><text class="muted">{{item.status}}</text></view></view>
