<view class="page"><view class="title">购物清单</view><button bindtap="add">添加采购项</button><view wx:if="{{loading}}" class="card muted">正在加载…</view><view wx:if="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重试</button></view><view wx:if="{{!loading && !error && !items.length}}" class="card muted">清单是空的，今晚可以轻松回家。</view><view wx:for="{{items}}" wx:key="id" class="card"><text>{{item.checkedAt ? '✓' : '○'}} {{item.name}}</text><button wx:if="{{!item.checkedAt}}" size="mini" data-id="{{item.id}}" bindtap="check">已买到</button></view></view>
