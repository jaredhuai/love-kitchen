<view class="page"><view class="title">冰箱库存</view><button bindtap="add">添加食材</button><view wx:if="{{loading}}" class="card muted">正在加载…</view><view wx:if="{{error}}" class="card"><text>{{error}}</text><button bindtap="load">重试</button></view><view wx:if="{{!loading && !error && !items.length}}" class="card muted">还没有库存，添加第一份食材吧。</view><view wx:for="{{items}}" wx:key="id" class="card"><text>{{item.name}} · {{item.quantity}}{{item.unit}}</text><button size="mini" data-id="{{item.id}}" bindtap="consume">使用 1 份</button></view></view>
