.page{padding:32rpx}.top{display:flex;justify-content:space-between;align-items:flex-start;padding:24rpx 0 32rpx}.eyebrow{display:block;color:#8c7474;font-size:24rpx}.title{display:block;font-size:44rpx;font-weight:600;margin:8rpx 0}.bell{font-size:52rpx;color:#f58ca8}.card{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(74,54,54,.06)}.couple{display:flex;align-items:center;justify-content:center;gap:22rpx;flex-wrap:wrap;background:linear-gradient(135deg,#fff0f3,#fff9f5)}.avatar{width:108rpx;height:108rpx;border-radius:50%;background:#f8c7d3;display:flex;align-items:center;justify-content:center;color:#4a3636}.second{background:#f4dfd0}.heart{font-size:48rpx;color:#ff6b6b}.days{width:100%;text-align:center;color:#8c7474;font-size:24rpx}.section-title{font-size:32rpx;font-weight:600}.pink{float:right;color:#ff6b6b;font-size:26rpx}.choice{display:flex;justify-content:space-between;padding:28rpx 0 4rpx;color:#8c7474}.heart-fill{color:#ff6b6b;font-size:42rpx}.ai-card{display:flex;justify-content:space-between;align-items:center;padding:30rpx;border-radius:28rpx;background:linear-gradient(135deg,#f0eaff,#faf7ff);margin-bottom:32rpx}.ai-title{display:block;color:#7156c9;font-size:34rpx;font-weight:600;margin-bottom:8rpx}.ai-btn{margin:0;background:#a78bfa;color:#fff;border-radius:999rpx;font-size:24rpx}.block-title{margin:32rpx 4rpx 18rpx}.today-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.meal-box{background:#fff;border-radius:24rpx;padding:24rpx;min-height:150rpx;box-shadow:0 6rpx 18rpx rgba(74,54,54,.05)}.meal-head{display:flex;justify-content:space-between;font-weight:600;border-bottom:1rpx solid #f7e5e7;padding-bottom:14rpx}.meal-count{font-size:22rpx;color:#f58ca8}.not-arranged{color:#a89595;font-size:24rpx;padding-top:28rpx}.dish-row{display:flex;justify-content:space-between;align-items:center;padding-top:18rpx}.dish-name{font-size:26rpx;color:#6d5656;max-width:150rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.remove{font-size:22rpx;color:#ff6b6b}.memory{color:#8c7474;line-height:1.7}.memory .muted{display:block;margin-top:12rpx}
.dish-modal{position:fixed;inset:0;background:rgba(74,54,54,.4);display:flex;align-items:center;justify-content:center;z-index:20}.dish-dialog{width:78%;background:#fff9f5;border-radius:28rpx;padding:28rpx}.dish-image{height:260rpx;background:#f8c7d3;border-radius:20rpx;overflow:hidden}.dish-image image{width:100%;height:100%}.dish-title{display:block;font-size:38rpx;font-weight:600;margin:22rpx 0 12rpx}
.ai-card{display:flex;justify-content:space-between;align-items:center;padding:28rpx;border-radius:28rpx;background:linear-gradient(135deg,#f0eaff,#faf7ff);margin:22rpx 0}.ai-title{display:block;color:#7156c9;font-size:32rpx;font-weight:600}.new-badge{font-size:20rpx;background:#ff6b6b;color:#fff;border-radius:999rpx;padding:4rpx 10rpx}.ai-arrow{color:#8b6ee8;font-size:24rpx}
.feature-icon{width:82rpx;height:82rpx;flex:none;margin-right:18rpx}.ai-copy{min-width:0;flex:1}.heading-icon{width:52rpx;height:52rpx;flex:none;margin-right:10rpx}.memory-heading{display:flex;align-items:center}.upload-empty{display:flex;flex-direction:column;align-items:center;justify-content:center}.upload-empty image{width:78rpx;height:78rpx}.upload-empty text{font-size:22rpx;margin-top:4rpx}
.memory-heading{color:#ff6b6b;font-size:28rpx}.memory-wrap{display:flex;gap:18rpx;margin:10rpx 0 40rpx}.memory-note{position:relative;flex:1;background:#fff0c9;border-radius:18rpx;padding:28rpx 22rpx;color:#7c6257;font-size:25rpx;line-height:1.8;box-shadow:0 8rpx 16rpx rgba(210,164,80,.14);transform:rotate(-2deg)}.note-heart{position:absolute;right:24rpx;bottom:8rpx;color:#ff6b6b;font-size:44rpx}.photo-placeholder{width:170rpx;height:170rpx;flex:none;overflow:hidden;border-radius:20rpx;background:#fff0f3;color:#e9a5b5;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:52rpx}.memory-photo{display:block;width:100%;height:100%;background:#fff}.photo-placeholder text{font-size:22rpx;margin-top:8rpx}
.couple-card{display:flex;align-items:center;justify-content:center;gap:22rpx;flex-wrap:wrap;background:linear-gradient(135deg,#fff0f3,#fff9f5)}.couple-card .avatar{width:92rpx;height:92rpx;border-radius:50%;background:#f8c7d3;display:flex;align-items:center;justify-content:center}.couple-card .partner{background:#f4dfd0}.couple-heart{font-size:50rpx;color:#ff6b6b}.couple-caption{width:100%;text-align:center;color:#8c7474;font-size:24rpx}
.today-list{display:flex;flex-direction:column;gap:18rpx}.today-list .meal-box{min-height:0}.today-list .dish-row{display:block;padding:20rpx 0 0}.dish-main{display:flex;align-items:center;gap:18rpx}.dish-thumb{width:112rpx;height:112rpx;flex:none;border-radius:20rpx;background:#f6d6dc}.dish-placeholder{display:flex;align-items:center;justify-content:center;color:#fff;font-size:34rpx}.dish-name{display:block;max-width:430rpx;font-size:28rpx;font-weight:600;color:#5d4545}.dish-actions{display:flex;gap:14rpx;margin-top:16rpx}.meal-action{flex:1;margin:0;height:58rpx;line-height:58rpx;border-radius:999rpx;font-size:22rpx}.meal-action::after{border:0}.meal-action.complete{background:#e1f4e7;color:#397b50}.meal-action.cancel{background:#fff0f3;color:#d65573}
