<view class="page"><view class="title">账号与隐私</view><view class="card"><button bindtap="privacy">隐私政策</button><button bindtap="terms">用户协议</button><button loading="{{loading}}" bindtap="exportData">导出我的数据</button></view><view wx:if="{{deletion}}" class="card"><view>账号处于注销冷静期</view><view class="muted">计划时间：{{deletion.scheduledFor}}</view><button bindtap="cancelDeletion">取消注销</button></view><button bindtap="logout">退出登录</button><button type="warn" loading="{{loading}}" bindtap="requestDeletion">申请注销账号</button></view>
