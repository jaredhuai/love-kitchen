.page{padding:32rpx}.title{display:block;margin:32rpx 0 8rpx;font-size:42rpx;font-weight:700;color:#4a3636}.subtitle{display:block;margin-bottom:28rpx;color:#9a8585;font-size:24rpx}.summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.summary-card{padding:24rpx;border-radius:24rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(94,58,58,.08)}.summary-number{display:block;color:#4a3636;font-size:36rpx;font-weight:700}.summary-label{display:block;margin-top:8rpx;color:#9a8585;font-size:22rpx}.insight-card{margin:22rpx 0;padding:26rpx;border-radius:24rpx;background:#fff0f3}.insight-title{display:block;color:#8c7474;font-size:22rpx}.insight-value{display:block;margin-top:8rpx;color:#d65573;font-size:34rpx;font-weight:700}.section-title{margin:32rpx 0 16rpx;color:#4a3636;font-size:30rpx;font-weight:700}.day-card{margin-bottom:16rpx;padding:0;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(94,58,58,.06);overflow:hidden}.day-head{min-height:94rpx;padding:20rpx 22rpx;display:flex;align-items:center;justify-content:space-between;color:#4a3636}.day-date{display:block;font-size:26rpx;font-weight:700}.day-count{display:block;margin-top:6rpx;color:#9a8585;font-size:21rpx}.fold-arrow{width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid #62463d;border-radius:50%;background:#fffdf8;color:#62463d;font-size:28rpx}.day-events{padding:0 22rpx 8rpx;border-top:1rpx dashed #e7d5ce}.day-event{min-height:78rpx;display:flex;align-items:center;gap:16rpx;border-bottom:1rpx solid #f3e7e2}.day-event:last-child{border-bottom:0}.event-time{width:74rpx;flex:none;color:#8c7474;font-size:21rpx}.event-main{min-width:0;flex:1}.event-dish{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#4a3636;font-size:24rpx;font-weight:600}.event-meal{display:block;margin-top:4rpx;color:#9a8585;font-size:20rpx}.event-status{flex:none;padding:7rpx 14rpx;border-radius:999rpx;background:#e6f4e9;color:#3d7a51;font-size:20rpx}.day-event.cancelled .event-status{background:#fff0ed;color:#c75a40}.top-row{display:flex;justify-content:space-between;margin-bottom:14rpx;padding:20rpx 22rpx;border-radius:20rpx;background:#fff;color:#4a3636;font-size:24rpx}.state{text-align:center;color:#8c7474;padding:100rpx 30rpx;line-height:1.7}.state.compact{padding:36rpx 0}.state button{margin-top:24rpx}
