.page{padding:32rpx}.hero{padding:36rpx 8rpx 32rpx}.eyebrow{display:block;color:#8b6ed7;font-size:24rpx;font-weight:600;margin-bottom:16rpx}.title{display:block;font-size:42rpx;font-weight:650;margin-bottom:14rpx}.request-card{background:linear-gradient(145deg,#fff,#faf7ff)}.request-input{width:100%;height:190rpx;box-sizing:border-box;padding:24rpx;background:#fffaf8;border:2rpx solid #f1e8e5;border-radius:20rpx;line-height:1.6}.quick-list{display:flex;gap:12rpx;overflow-x:auto;margin:22rpx 0}.quick-item{flex:none;padding:12rpx 20rpx;border-radius:999rpx;background:#f1ecff;color:#7359b5;font-size:23rpx}.request-footer{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.servings{padding:18rpx 22rpx;background:#fff;border-radius:18rpx;color:#6f5e5e}.ask-btn{flex:1;margin:0;font-size:28rpx}.error-card{border:2rpx solid #ffd8d8;color:#b94e4e}.error-title{display:block;font-weight:600;margin-bottom:10rpx}.retry{display:block;color:#8b6ed7;margin-top:18rpx}.results{padding-top:14rpx}.results>.section-title{display:block;margin:8rpx 4rpx 24rpx}.recommendation-card{display:flex;gap:24rpx}.recommendation-number{display:flex;align-items:center;justify-content:center;flex:none;width:56rpx;height:56rpx;border-radius:50%;background:linear-gradient(135deg,#f7b4c8,#c4afff);color:#fff;font-weight:700}.recommendation-content{min-width:0;flex:1}.dish-name{display:block;font-size:34rpx;font-weight:650;margin:5rpx 0 12rpx}.reason{display:block;color:#745f5f;line-height:1.65}.ingredients{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.ingredient{padding:8rpx 16rpx;border-radius:12rpx;background:#fff3ed;color:#8a6254;font-size:23rpx}
