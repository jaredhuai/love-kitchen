<view class="page"><view class="card"><view class="title">欢迎回家</view><view class="muted">登录后进入只属于德德与桐桐的小厨房</view><input password value="{{accessPassword}}" maxlength="128" bindinput="onPasswordInput" placeholder="请输入访问密码"/><checkbox-group class="agreement-group" bindchange="onAgreementChange"><label class="agreement"><checkbox value="forever" checked="{{agreed}}" color="#f58ca8"/><text>请确定和德德/桐桐相爱一辈子。</text></label></checkbox-group><button class="primary" loading="{{loading}}" disabled="{{!agreed || loading}}" bindtap="wechatLogin">微信安全登录</button><button wx:if="{{canUseDevLogin}}" disabled="{{!agreed || loading}}" bindtap="devLogin">仅开发环境登录</button></view></view>
