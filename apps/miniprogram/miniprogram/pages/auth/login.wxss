.login-card {
  margin-top: 21vh;
  padding: 48rpx 36rpx 42rpx;
  text-align: center;
  overflow: hidden;
}

.muted {
  margin: 24rpx 0 26rpx;
}

.opening-banner {
  margin: -14rpx auto 34rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #efb4c3;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff2f6, #ffe4eb);
  color: #7a4c58;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: .04em;
  box-shadow: 0 8rpx 20rpx rgba(226, 124, 151, .13);
  animation: banner-glow 2.4s ease-in-out infinite;
}

.opening-day {
  margin: 0 5rpx;
  color: #e35f84;
  font-size: 34rpx;
  font-family: Georgia, serif;
}

.opening-spark {
  margin: 0 10rpx;
  color: #ef88a4;
}

.heart-stage {
  position: relative;
  width: 300rpx;
  height: 300rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-entry {
  box-sizing: border-box;
  position: relative;
  z-index: 3;
  width: 176rpx;
  height: 176rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #ffd8e2, #f58ca8);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow:
    0 20rpx 42rpx rgba(245, 140, 168, .34),
    0 0 0 8rpx rgba(255, 225, 233, .72),
    inset 0 5rpx 10rpx rgba(255, 255, 255, .86);
  animation: heart-beat 1.8s ease-in-out infinite;
}

.heart-entry-pressed {
  transform: scale(.9);
  box-shadow: 0 8rpx 20rpx rgba(245, 140, 168, .26);
}

.heart-entry.is-loading {
  background: linear-gradient(145deg, #ffe0e8, #efa2b5);
  box-shadow: 0 12rpx 28rpx rgba(245, 140, 168, .22);
}

.heart-symbol {
  position: relative;
  z-index: 2;
  color: #fff;
  font-family: Georgia, serif;
  font-size: 104rpx;
  line-height: 1;
  text-shadow: 0 5rpx 12rpx rgba(169, 67, 94, .24);
  transform: translateY(3rpx);
}

.heart-shine {
  position: absolute;
  top: 20rpx;
  left: 31rpx;
  width: 56rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .42);
  transform: rotate(-28deg);
  filter: blur(2rpx);
}

.heart-halo {
  position: absolute;
  z-index: 1;
  width: 170rpx;
  height: 170rpx;
  border: 3rpx solid rgba(245, 140, 168, .4);
  border-radius: 50%;
  animation: halo 2.2s ease-out infinite;
}

.halo-two {
  animation-delay: 1.1s;
}

.spark {
  position: absolute;
  z-index: 2;
  color: #f58ca8;
  font-family: Georgia, serif;
  animation: sparkle 2.4s ease-in-out infinite;
}

.spark-one {
  top: 42rpx;
  left: 38rpx;
  font-size: 34rpx;
}

.spark-two {
  top: 58rpx;
  right: 38rpx;
  font-size: 30rpx;
  animation-delay: .65s;
}

.spark-three {
  right: 24rpx;
  bottom: 52rpx;
  font-size: 28rpx;
  animation-delay: 1.25s;
}

.heart-hint {
  margin-top: -18rpx;
  color: #6d4a4a;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: .05em;
}

.legal-note {
  margin-top: 28rpx;
  color: #aa9090;
  font-size: 22rpx;
  line-height: 1.8;
}

.legal-link {
  color: #d8708d;
  text-decoration: underline;
}

.dev-login {
  margin-top: 28rpx;
}

@keyframes heart-beat {
  0%, 100% { transform: scale(1); }
  15% { transform: scale(1.08); }
  30% { transform: scale(.98); }
  45% { transform: scale(1.05); }
  65% { transform: scale(1); }
}

@keyframes halo {
  0% { opacity: .65; transform: scale(.8); }
  100% { opacity: 0; transform: scale(1.65); }
}

@keyframes sparkle {
  0%, 100% { opacity: .25; transform: translateY(8rpx) scale(.8) rotate(-8deg); }
  50% { opacity: 1; transform: translateY(-8rpx) scale(1.15) rotate(8deg); }
}

@keyframes banner-glow {
  0%, 100% { box-shadow: 0 8rpx 20rpx rgba(226, 124, 151, .11); }
  50% { box-shadow: 0 10rpx 28rpx rgba(226, 124, 151, .24); }
}
