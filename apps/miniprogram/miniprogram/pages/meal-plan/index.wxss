.page{padding:32rpx}.header{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:32rpx 0}.header-copy{flex:none}.title{display:block;font-size:42rpx;font-weight:700}.subtitle{display:block;margin-top:10rpx;color:#9a8585;font-size:24rpx}.menu-search{height:68rpx;min-width:0;flex:1;display:flex;align-items:center;padding:0 18rpx;border:2rpx solid #edcad4;border-radius:999rpx;background:#fff8fa;box-shadow:0 6rpx 16rpx rgba(214,85,115,.08)}.menu-search input{min-width:0;flex:1;color:#5a4038;font-size:23rpx}.search-heart{margin-right:8rpx;color:#e47997;font-size:30rpx}.search-clear{padding:8rpx;color:#b88f99;font-size:28rpx}.category-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx}.category-card{min-width:0;padding:12rpx 10rpx 16rpx;border:2rpx solid #e7d3cc;border-radius:24rpx;background:#fffdf9;box-shadow:0 8rpx 20rpx rgba(94,58,58,.07);text-align:center;transition:transform .18s ease}.category-card.active{border-color:#e98ba4;background:#fff2f6;transform:translateY(-4rpx)}.category-icon{display:block;width:100%;height:142rpx;border-radius:18rpx;background:#fff9f5}.category-name{display:block;margin-top:8rpx;color:#5a4038;font-size:25rpx;font-weight:700}.category-count{display:block;margin-top:4rpx;color:#a58b86;font-size:19rpx}.category-section-head{display:flex;align-items:center;justify-content:space-between;margin:34rpx 0 18rpx}.category-section-title{display:block;color:#4a3636;font-size:34rpx;font-weight:700}.category-section-count{display:block;margin-top:4rpx;color:#9a8585;font-size:21rpx}.category-back{width:104rpx;height:62rpx;font-size:22rpx}.category-empty{padding:42rpx 24rpx;border-radius:24rpx;background:#fff;color:#9a8585;font-size:23rpx;text-align:center}.meal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx}.meal-card{overflow:visible;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(94,58,58,.1);padding-bottom:16rpx}.image-wrap{position:relative;aspect-ratio:1/1;overflow:hidden;border-radius:28rpx 28rpx 0 0;background:#ead8d1}.meal-image{position:absolute;inset:0;width:100%;height:100%}.placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#f8cad6,#d9b5a6);color:rgba(255,255,255,.82);font-size:96rpx;font-weight:700}.image-shade{position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(44,26,26,.78))}.meal{position:absolute;left:20rpx;right:20rpx;bottom:18rpx;color:#fff;font-size:30rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-shadow:0 2rpx 8rpx rgba(0,0,0,.3)}.add-meal{margin:14rpx 16rpx 0;height:72rpx;padding:0 8rpx;font-size:22rpx;line-height:1}.add-meal .btn-heart{margin-right:8rpx;font-size:29rpx}.add-meal .btn-flourish{margin-left:7rpx;font-size:20rpx}.empty{text-align:center;color:#8c7474;padding:100rpx 0}.empty button{margin-top:24rpx}
.future-title{margin:42rpx 0 18rpx}.future-empty{padding:30rpx 24rpx;border-radius:22rpx;background:#fff;color:#8c7474;font-size:23rpx;line-height:1.6}.future-day{margin-bottom:20rpx;padding:22rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(94,58,58,.06)}.future-date{display:block;margin-bottom:8rpx;color:#4a3636;font-size:27rpx;font-weight:700}.future-row{min-height:88rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;border-top:1rpx dashed #ead8d1}.future-dish{display:block;color:#4a3636;font-size:25rpx;font-weight:600}.future-meal{display:block;margin-top:5rpx;color:#9a8585;font-size:21rpx}.future-cancel{flex:none;margin:0!important;min-height:58rpx!important;padding:0 18rpx!important;font-size:21rpx!important}.schedule-mask{position:fixed;inset:0;z-index:50;padding:32rpx;display:flex;align-items:flex-end;background:rgba(74,54,54,.42)}.schedule-dialog{width:100%;box-sizing:border-box;padding:30rpx;border:3rpx solid #62463d;border-radius:34rpx 34rpx 24rpx 24rpx;background:#fff9f5;box-shadow:8rpx 10rpx 0 rgba(98,70,61,.18)}.schedule-head{display:flex;align-items:center;justify-content:space-between}.schedule-eyebrow{display:block;color:#d65573;font-size:22rpx}.schedule-dish{display:block;margin-top:6rpx;color:#4a3636;font-size:34rpx;font-weight:700}.schedule-close{width:64rpx;height:64rpx;flex:none;font-size:38rpx}.schedule-label{display:block;margin:28rpx 0 14rpx;color:#8c7474;font-size:23rpx}.date-quick{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.date-choice,.date-picker,.meal-choice{height:70rpx;font-size:24rpx}.date-choice .btn-heart{margin-right:8rpx;font-size:28rpx}.date-picker{margin-top:16rpx}.selected{background:#f8c6d2;color:#5a4038;box-shadow:5rpx 6rpx 0 #e8b5c1}.meal-options{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.meal-choice{padding:0 8rpx}.schedule-actions{display:grid;grid-template-columns:1fr 1.35fr;gap:18rpx;margin-top:32rpx}.schedule-actions button{margin:0}.schedule-cancel{background:#f4efff!important}.schedule-confirm{min-width:0;padding:0 18rpx!important}.schedule-confirm .btn-heart{margin-right:8rpx}.schedule-confirm .btn-flourish{margin-left:7rpx}
