<view class="page"><view class="card"><text class="label">菜名</text><input placeholder="例如：番茄牛腩" value="{{name}}" bindinput="onName"/><text class="label">描述</text><textarea placeholder="写下这道菜的味道和故事" value="{{description}}" bindinput="onDescription"/><button bindtap="chooseImage" class="outline">上传菜品照片</button><text wx:if="{{uploadProgress > 0 && uploadProgress < 100}}" class="muted">上传中 {{uploadProgress}}%</text><button bindtap="save" loading="{{saving}}" disabled="{{saving}}" class="primary-btn">保存菜品</button></view></view>
