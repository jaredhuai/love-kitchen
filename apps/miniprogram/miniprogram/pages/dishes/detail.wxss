.page{padding:0 24rpx 140rpx}.hero-image{height:430rpx;background:linear-gradient(135deg,#f5c1cb,#fbe9dc);border-radius:0 0 28rpx 28rpx;position:relative;overflow:hidden}.hero-image image{width:100%;height:100%}.image-placeholder{display:flex;align-items:center;justify-content:center;height:100%;color:#8c7474;font-size:42rpx}.card{background:#fff;border-radius:26rpx;padding:26rpx;margin:22rpx 0;box-shadow:0 8rpx 20rpx rgba(74,54,54,.06)}.summary-top,.section-head{display:flex;justify-content:space-between;align-items:center}.dish-title{font-size:40rpx;font-weight:600;display:block}.dish-description{margin-top:18rpx;color:#8c7474;font-size:25rpx;line-height:1.7}.tags{display:flex;gap:10rpx;margin-top:14rpx;flex-wrap:wrap}.tags text{font-size:21rpx;color:#f58ca8;background:#fff0f3;border-radius:8rpx;padding:6rpx 10rpx}.rating{margin-top:22rpx;color:#8c7474;font-size:23rpx}.stars,.review-stars{color:#ffb14e;letter-spacing:5rpx}.section-title{font-size:30rpx;font-weight:600}.section-empty{margin-top:22rpx;color:#a89595;font-size:24rpx}.ingredient-grid{display:grid;grid-template-columns:1fr;gap:18rpx;margin-top:22rpx}.ingredient{display:flex;align-items:center;gap:8rpx;font-size:24rpx;line-height:1.5}.ingredient-icon{color:#f58ca8;font-size:20rpx}.step{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #f7e5e7;line-height:1.6}.step-no{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border-radius:50%;background:#ff6b6b;color:#fff;font-size:20rpx;flex:none}.review{display:flex;gap:18rpx;padding:18rpx 0;border-bottom:1rpx solid #f7e5e7}.review-avatar{width:58rpx;height:58rpx;border-radius:50%;background:#fff0f3;color:#f58ca8;display:flex;align-items:center;justify-content:center}.review text{display:block;margin-bottom:8rpx}.story{background:#fff0f3}.empty{text-align:center;padding:120rpx 20rpx;color:#8c7474}
.image-strip{width:100%;margin-top:16rpx;white-space:nowrap}.image-strip image{width:154rpx;height:116rpx;margin-right:12rpx;border:4rpx solid #fff;border-radius:18rpx;box-shadow:0 6rpx 14rpx rgba(74,54,54,.12)}.dish-notes{margin-top:18rpx;padding:18rpx;border-radius:18rpx;background:#fff6f8;color:#795b62;font-size:24rpx;line-height:1.6}.dish-notes text{display:block}.dish-notes text:first-child{margin-bottom:6rpx;color:#d65573;font-weight:700}
