<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <block wx:else>
    <view class="hero-image"><image wx:if="{{dish.imageUrl}}" src="{{dish.imageUrl}}" mode="aspectFill"/><text wx:else class="image-placeholder">我们的厨房</text></view>
    <view class="card dish-summary"><view class="summary-top"><view><text class="dish-title">{{dish.name}}</text><view class="tags"><text>{{dish.category || '家常菜'}}</text><text>添加人：{{dish.addedBy}}</text><text>{{dish.servings || 2}}人份</text></view></view></view><view wx:if="{{dish.displayDescription}}" class="dish-description">{{dish.displayDescription}}</view><view class="rating"><text class="stars">★★★★★</text><text> 4.8 (328)</text></view></view>
    <view class="card"><view class="section-head"><text class="section-title">食材清单</text><text class="muted">{{dish.servings || 2}}人份</text></view><view wx:if="{{!dish.ingredients.length}}" class="section-empty">还没有添加食材。</view><view class="ingredient-grid"><view wx:for="{{dish.ingredients}}" wx:key="id" class="ingredient"><text class="ingredient-icon">●</text><text>{{item.displayName}}</text><text class="muted">{{item.quantity || ''}}{{item.unit || ''}}</text></view></view></view>
    <view class="card"><view class="section-head"><text class="section-title">步骤</text><text class="muted">按顺序完成</text></view><view wx:if="{{!dish.steps.length}}" class="section-empty">还没有添加步骤。</view><view wx:for="{{dish.steps}}" wx:key="id" class="step"><text class="step-no">{{index + 1}}</text><text>{{item.content}}</text></view></view>
    <view class="card"><view class="section-head"><text class="section-title">双方评价</text><text class="muted">共 {{dish.reviews.length || 0}} 条</text></view><view wx:for="{{dish.reviews}}" wx:key="id" class="review"><view class="review-avatar">♡</view><view><text>我们的厨房成员</text><text class="review-stars">★★★★★</text><text class="muted">{{item.content || '很好吃，下次还做。'}}</text></view></view></view>
    <view class="card story"><text class="section-title">我们的故事</text><text class="muted">每一道菜，都记录着我们一起生活的片段。</text></view>
  </block>
</view>
